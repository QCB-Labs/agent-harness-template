#!/bin/sh
# Check staged memory writes quickly; code changes still require the full suite.
if [ -n "$AGENT_PYTHON" ]; then
    PY="$AGENT_PYTHON"
elif [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
else
    PY="python"
fi

"$PY" -m tools.commit_scope
SCOPE=$?
case "$SCOPE" in
    0) exit 0 ;;
    1) echo "BLOCKED: staged privacy checks failed"; exit 1 ;;
esac

echo "Running tests..."
"$PY" -m pytest -q 2>&1 || { echo "BLOCKED: tests failed"; exit 1; }
